.container {
  padding: 40rpx 30rpx;
}

.title-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #888888;
}

.upload-section {
  width: 100%;
  margin-bottom: 50rpx;
}

.upload-area {
  width: 100%;
  height: 400rpx;
  background-color: #1a1a1a;
  border-radius: 20rpx;
  border: 2rpx dashed #444444;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  font-size: 80rpx;
  color: #555555;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #666666;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.options-section {
  width: 100%;
  margin-bottom: 50rpx;
}

.option-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #222222;
}

.option-label {
  font-size: 30rpx;
  color: #cccccc;
}

.option-input {
  width: 300rpx;
  height: 60rpx;
  background-color: #1a1a1a;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #ffffff;
}

.picker-value {
  font-size: 28rpx;
  color: #00d4aa;
  padding: 10rpx 20rpx;
  background-color: #1a1a1a;
  border-radius: 10rpx;
}

.action-section {
  width: 100%;
  margin-top: 30rpx;
}

.generate-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #00d4aa 0%, #00a8ff 100%);
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.generate-btn.disabled {
  opacity: 0.5;
}

.btn-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.privacy-dialog {
  width: 80%;
  background-color: #1a1a1a;
  border-radius: 20rpx;
  padding: 40rpx;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-bottom: 30rpx;
}

.privacy-content {
  font-size: 28rpx;
  color: #cccccc;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.privacy-link {
  color: #00d4aa;
  display: inline;
}

.privacy-btns {
  display: flex;
  gap: 20rpx;
}

.privacy-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.privacy-btn.reject {
  background-color: #333333;
  color: #999999;
}

.privacy-btn.agree {
  background: linear-gradient(135deg, #00d4aa 0%, #00a8ff 100%);
  color: #ffffff;
}
