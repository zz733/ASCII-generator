.container {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-section {
  width: 100%;
  margin-bottom: 60rpx;
  background-color: #1a1a1a;
  border-radius: 20rpx;
  padding: 20rpx;
}

.result-image {
  width: 100%;
  border-radius: 10rpx;
}

.loading-placeholder {
  width: 100%;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #666666;
}

.action-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #00d4aa 0%, #00a8ff 100%);
}

.action-btn.secondary {
  background-color: #2a2a2a;
}

.action-btn.outline {
  background-color: transparent;
  border: 2rpx solid #444444;
}

.btn-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

.action-btn.outline .btn-text {
  color: #cccccc;
}
